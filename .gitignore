node_modules/
.env
.env*

# Lo que deja Playwright al correr: las trazas de los fallos y las capturas.
# No van al repositorio porque son de una máquina concreta y ocupan.
test-results/
playwright-report/
blob-report/
.playwright/

# …salvo el ejemplo, que es la lista de variables SIN VALOR: sin él, quien
# clone el repositorio no sabe qué claves hacen falta ni para qué. Es la
# excepción va DESPUÉS de la regla, que es lo que la anula.
!.env.example

# Datos del proyecto enlazado: ref, pooler-url y versiones. No es un secreto,
# pero es de tu cuenta y no va al repositorio.
supabase/.temp/

data/usuarios.json
data/usuarios.tmp.json
data/sesiones.json
data/sesiones.tmp.json
*.log
_t.html
_m.html
_e2e.html
_u.html
.vercel

# Ficheros sueltos de depuración y capturas de trabajo.
*.png
/movil*.mjs
/ancho*.mjs

# …salvo las dos imágenes que sí son parte del sitio: la tarjeta Open Graph y
# el logo cuadrado que declara el JSON-LD. Se generan desde tools/*.html con
# Chrome headless, pero el PNG es lo que se sirve y va en el repositorio.
!og.png
!logo.png
