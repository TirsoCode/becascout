# BecasScout — la lista de variables. NO lleva ningún valor: es la plantilla.
#
# Este fichero SÍ está en el repositorio (el `.gitignore` lo excluye y luego
# lo vuelve a incluir con `!.env.example`), y por eso no puede traer claves.
# Las de verdad viven en `.env.local`, que no se sube a ningún sitio, y en
# Vercel, que es donde las lee el servidor.
#
# Copia de las claves que hay que poner en el proyecto de Supabase, para no
# tenerlas buscando por el dashboard. Lo que se deploya va con:
#
#   vercel env add SUPABASE_URL            production
#   vercel env add SUPABASE_ANON_KEY       production
#   vercel env add SUPABASE_SERVICE_ROLE_KEY production
#
# SUPABASE_SERVICE_ROLE_KEY da acceso total a la base de datos. Si alguna vez
# sale de aquí, la clave se rota en el dashboard y se vuelve a subir.

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Client ID de Google OAuth del proyecto. El backend lo usa para comprobar el
# `aud` del access token que manda /auth/callback (ver registro-google en
# api/[...ruta].js). El secret NO va aquí: vive en el proveedor de Google
# dentro de Supabase.
GOOGLE_CLIENT_ID=

# Contraseña de Postgres del proyecto. La usa solo `supabase db push`, nunca
# la web. Está aquí por comodidad; si prefieres no guardarla, bórrala y
# ponla cuando la pida.
POSTGRES_PASSWORD=

# ── Avisos de plazo (el cron diario) ──────────────────────────────────────
#
# El cron (vercel.json → crons → /api/cron-avisos) envía un correo cuando una
# convocatoria de la base cierra en los próximos 7 días. Sin estas dos, el cron
# responde «sin configuración de envío» y no marca nada: los avisos se quedan
# en la cola y salen cuando se configuren.
#
# RESEND_API_KEY: la clave de Resend. Sale de resend.com → API keys.
# CORREO_DE: el remitente, con su nombre: "BecasScout <avisos@tu-dominio>".
#   El dominio tiene que estar VERIFICADO en Resend (resend.com/domains) o el
#   envío se rechaza con un 403. Sin dominio verificado solo se puede enviar
#   al propio correo de la cuenta de Resend.
#
# CRON_SECRET: la contraseña que el cron exige en la cabecera
#   `authorization: Bearer <secreto>`. Vercel la manda solo si la variable
#   existe; si no está, la ruta responde sin comprobar a nadie. Ponla
#   siempre.
RESEND_API_KEY=
CORREO_DE=
CRON_SECRET=